{
  "name": "ctxnazar",
  "version": "0.1.0",
  "description": "A lightweight, local-first scanner for secrets in AI agent context files.",
  "type": "module",
  "bin": { "ctxnazar": "dist/cli.js" },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "engines": { "node": ">=20" },
  "keywords": ["ai-security", "ai-agents", "claude-code", "codex", "cursor", "context-engineering", "secret-scanning", "developer-tools", "cli", "typescript"],
  "author": "İlhan Emir",
  "repository": { "type": "git", "url": "git+https://github.com/hanzales/ctxnazar.git" },
  "homepage": "https://github.com/hanzales/ctxnazar#readme",
  "bugs": { "url": "https://github.com/hanzales/ctxnazar/issues" },
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
